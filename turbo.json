{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "db:generate": {
      "outputs": [
        "src/generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "VITE_*"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types",
        "db:generate"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint",
        "db:generate"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false,
    }
  }
}
