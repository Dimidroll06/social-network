FROM node:26-alpine as base
ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}/bin:${PNPM_HOME}:${PATH}"
RUN npm install -g pnpm@12.23.0

FROM base AS pruner
WORKDIR /app
RUN pnpm add -g turbo@2.11.13
COPY . .
ARG SERVICE_NAME
RUN turbo prune ${SERVICE_NAME} --docker

FROM base AS installer
WORKDIR /app
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full .
ARG SERVICE_NAME
RUN pnpm turbo run build --filter=${SERVICE_NAME}... && \
    pnpm prune --prod

FROM node:26-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

ARG SERVICE_NAME
# 1000 - node user/group in node-alpine image
COPY --from=installer --chown=1000:1000 /app/node_modules ./node_modules
COPY --from=installer --chown=1000:1000 /app/packages ./packages
COPY --from=installer --chown=1000:1000 /app/apps/${SERVICE_NAME}/node_modules ./apps/${SERVICE_NAME}/node_modules
COPY --from=installer --chown=1000:1000 /app/apps/${SERVICE_NAME}/dist ./apps/${SERVICE_NAME}/dist
COPY --from=installer --chown=1000:1000 /app/apps/${SERVICE_NAME}/package.json ./apps/${SERVICE_NAME}/package.json

USER 1000:1000

WORKDIR /app/apps/${SERVICE_NAME}
ENTRYPOINT [ "node", "dist/main.js" ]
