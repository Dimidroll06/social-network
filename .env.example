# Copy to .env and replace the passwords: cp .env.example .env

# --- users-db ---
USERS_DB_USER=users
USERS_DB_PASSWORD=change-me

# --- posts-db ---
POSTS_DB_USER=posts
POSTS_DB_PASSWORD=change-me

# --- rabbitmq ---
RABBITMQ_USER=social
RABBITMQ_PASSWORD=change-me

# --- web ---
# nginx port on the host
WEB_PORT=8080
# Base api-gateway URL for the browser. Inside the container requests go through
# the nginx /api proxy, so a relative path is used here.
VITE_API_GATEWAY_URL=/api
