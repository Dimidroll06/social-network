generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A short text post (Twitter-like). Managed by feed-service.
// authorId/userId are flat ids from other services (no cross-service relation).
model Post {
  id        String   @id @default(uuid(7))
  authorId  String
  content   String   @db.VarChar(280)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes   Like[]
  reposts Repost[]

  @@index([authorId])
  @@index([createdAt])
}

model Like {
  id        String   @id @default(uuid(7))
  userId    String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model Repost {
  id        String   @id @default(uuid(7))
  userId    String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}
