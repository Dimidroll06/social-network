# Applies prisma migrations. Only the Prisma CLI is needed here.
FROM node:22-alpine

WORKDIR /app

COPY prisma ./prisma

# Keep this in sync with the prisma version in package.json.
RUN npm install prisma@6.19.3 --no-audit --no-fund --no-save

CMD ["npx", "--no-install", "prisma", "migrate", "deploy"]
