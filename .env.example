POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-db-password

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Comma-separated browser origins allowed by backend CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

AUTH_PORT=4001
USER_PORT=4002
FEED_PORT=4003
FRONTEND_PORT=5173

# These are browser-visible URLs and therefore must point to the host ports.
VITE_AUTH_SERVICE_URL=http://localhost:4001
VITE_USER_SERVICE_URL=http://localhost:4002
VITE_FEED_SERVICE_URL=http://localhost:4003

