# Скопировать в .env и заменить пароли: cp .env.example .env

# --- users-db ---
USERS_DB_USER=users
USERS_DB_PASSWORD=change-me

# --- posts-db ---
POSTS_DB_USER=posts
POSTS_DB_PASSWORD=change-me

# --- rabbitmq ---
RABBITMQ_USER=social
RABBITMQ_PASSWORD=change-me

# --- web ---
# Порт nginx на хосте
WEB_PORT=8080
# Базовый URL api-gateway для браузера. В контейнере запросы идут через
# nginx-прокси /api, поэтому здесь относительный путь.
VITE_API_GATEWAY_URL=/api
