generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Credentials of a user. Managed by auth-service.
model User {
  id           String   @id @default(uuid(7))
  email        String   @unique
  passwordHash String
  // Incremented on each refresh rotation / logout to invalidate old refresh tokens.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
